# Pruning experiment config — children override these on their own branch.
# This is the ONLY file experiments vary; run.sh and the run command stay fixed.

# Base model to prune (HF id). Decoder-only causal LM (dense).
MODEL=google/gemma-4-31B

# Pruning method: magnitude | wanda | sparsegpt
PRUNE_METHOD=wanda

# Sparsity type: unstructured | 2:4 | 4:8
SPARSITY_TYPE=unstructured

# Sparsity ratio (0.5 = 50%). N:M types require 0.5.
SPARSITY_RATIO=0.5

# Calibration samples.
NSAMPLES=64

# Calibration/eval sequence length cap (also capped by model context).
SEQLEN=4096

# Save the pruned checkpoint as the model product? (1 = yes)
SAVE_MODEL=0

# transformers version to install for this model:
#   Qwen3 / Llama / Qwen2.5 / Mistral  -> 4.55.0
#   Gemma-4 (Gemma4ForConditionalGeneration) -> 5.9.0
TRANSFORMERS_VERSION=4.55.0

# What this node does: prune (default) | bench_cpu | bench_gpu
#   bench_cpu -> CPU dense-vs-CSR-sparse GEMM on our unstructured checkpoint
#   bench_gpu -> 2:4 semi-structured dense-vs-sparse GEMM on the GPU
MODE=bench_gpu
